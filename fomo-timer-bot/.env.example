# === Основное ===
# Токен от @BotFather (создать бота: /newbot)
BOT_TOKEN=
# @username бота — ЗАПОЛНЯЕТСЯ САМО при первом старте (нужно для отложенных
# пушей: они планируются в чат с ботом). Вручную не трогайте.
BOT_USERNAME=
# Часовой пояс по умолчанию (IANA)
DEFAULT_TZ=Europe/Moscow
# Файл БД (можно не менять)
DB_PATH=data/fomo_timers.db

# Предупреждение «через минуту» до финиша (вы выбрали «Только T-0» — оставьте false)
WARN_ENABLED=false

# === Автотрекинг через API игры ===
# РУКАМИ ЗДЕСЬ ЗАПОЛНЯТЬ НЕ НУЖНО.
# Просто положите fomo.txt в папку бота (или в token_updates/) — бот сам
# найдёт initData, включит автотрекинг и впишет значения сюда.
# Другой путь — одноразовый вход юзербота: login_bot.bat (см. README).
# Он тоже включит автотрекинг сам: сохранит ключ и поставит API_ENABLED=true —
# после входа юзербота fomo.txt не нужен вовсе.
API_ENABLED=false
# Полный адрес(а) эндпоинта состояния игры (несколько — через запятую)
API_STATE_URL=
# Строка заголовка авторизации целиком, например:
#   Authorization: Bearer eyJhbGciOiJIUzI1NiIs...
API_AUTH_HEADER=
# Метод и тело запроса (для подписанных POST-эндпоинтов — как у Fomo Fighters)
API_METHOD=GET
API_BODY=
# Дополнительные заголовки-подписи одним набором (пишется автоматически):
#   {"api-key": "…", "api-hash": "…", "api-time": "…", "api-version": "…"}
API_HEADERS_JSON=
# Интервал опроса игры в секундах. По умолчанию 300 (5 минут): опрос при
# старте бота, дальше раз в 5 минут — игре ничего не мешает, сессия не
# вылетает. Меньше 60 бот всё равно не возьмёт.
API_POLL_INTERVAL=300
# --- МОЗГ ОПРОСНИКА: скрытность без потери автоматизации (см. BRAIN.md) ---
# Разброс активного интервала: пауза = база * (1 ± POLL_JITTER), каждый раз
# новая — идеальная периодичность (сигнатура бота) исчезает.
POLL_JITTER=0.4
# Автопульс в тихом режиме (3 опроса без нового таймера): редкая проверка
# раз в случайный интервал из вилки 30–55 минут. Находит новые таймеры сам,
# тапать ничего не нужно. (Старый QUIET_HEARTBEAT_SEC>0 стал этой вилкой.)
POLL_PULSE_MIN=1800
POLL_PULSE_MAX=3300
# НОЧНОЙ РЕЖИМ: в окне ночи запросов к игре нет (люди спят), утро — со
# случайным сдвигом до 15 минут. Часовой пояс: пусто = пояс владельца из /tz.
BOT_TZ=
NIGHT_START=00:00
NIGHT_END=08:00
NIGHT_SILENT=true
NIGHT_MICROTICKS=false
NIGHT_WAKE_JITTER=900
# Пробуждение по сообщению владельца: случайные 3–8 минут (ранний опрос
# мог бы выбить игровую сессию переавторизацией).
WAKE_DELAY_MIN=180
WAKE_DELAY_MAX=480
# «Игрок занят»: писал боту в последние 180 с — плановые опросы откладываются.
OWNER_BUSY_WINDOW=180
# После реанимации ключа не трогаем игру 10 минут.
REAUTH_COOLDOWN=600
# Контрольный опрос после «⏰ Готово»: игрок идёт собирать — мы рядом.
CONTROL_POLL_MIN=30
CONTROL_POLL_MAX=120
# Спрашивать «Да/Нет» перед добавлением найденных таймеров
# (true — бот показывает список и ждёт подтверждения; false — ставит молча.
#  Переключается в боте без правки файла: команда /вопросы)
API_ASK_BEFORE_ADD=false
# Трассировка сырых ответов API в data/trace.log (поиск новых типов таймеров:
# клановые сундуки, награды аванпостов и т.п.). Переключается в боте:
# /трассировка, файл — /трейслог. Подробно: README → «Новые таймеры и переводы».
API_TRACE=false
# Ваш tg_id — кому ставить авто-таймеры. Обычно ПУСТО: login_bot.bat подставит
# ID вашего аккаунта сам при входе юзербота; иначе сработает первый /start боту.
API_OWNER_TG_ID=

# === Нативный режим Fomo Fighters (рекомендуется) ===
# initData мини-аппа. Заполняется САМО: положите fomo.txt (HAR с запросом
# /telegram/auth) в папку бота или в token_updates/ — или запустите
# login_bot.bat, и бот будет добывать initData сам. Если это поле непустое,
# подписи выше не нужны: бот сам подписывает каждый запрос и сам продлевает ключ.
FOMO_INIT_DATA=
# Адрес API и фронт игры (не меняйте, если игра обновится — поправим тут)
FOMO_API_BASE=https://api.fomofighters.xyz
FOMO_WEB_ORIGIN=https://game.fomofighters.xyz
# Мини-апп игры: t.me/<FOMO_GAME_BOT>/<FOMO_APP_NAME> (узнаётся из конфига игры)
FOMO_GAME_BOT=fomo_fighters_bot
FOMO_APP_NAME=game
FOMO_LANG=ru
# С 0.1.1.2 НЕ ИСПОЛЬЗУЕТСЯ: auth теперь только по необходимости (нет ключа
# или 401) — каждая переавторизация могла выкидывать игрока из игры.
# Ключ оставлен для совместимости старых .env.
FOMO_REAUTH_INTERVAL=21600
# Как часто опрашивать /user/data/all — клановые сундуки (перезарядка 1..30 ч
# по уровню клана) и награды аванпостов. Секунды, 300 = раз в 5 минут
# (в одном ритме с /user/data/timers).
FOMO_ALL_INTERVAL=300
# За сколько секунд до конца ОСАДЫ аванпоста прислать предупреждение
# «пора отправлять войска». 3600 = за час; 0 = выключить.
SIEGE_PREWARN_SEC=3600

# === Страница таймеров в браузере ===
# Экран со всеми таймерами сразу: живые отсчёты, тихий режим по группам,
# отмена таймеров, кнопка «Обновить». Открывается в ОБЫЧНОМ браузере на том
# устройстве, где запущен бот: http://127.0.0.1:8080 (мини-апп в Telegram и
# туннель cloudflared убраны до лучших времён). Уведомления в чат приходят
# как раньше и от страницы не зависят.
WEBAPP_ENABLED=true
# Локальный порт веб-сервера (слушает только 127.0.0.1). Занят — берёт следующий.
WEBAPP_PORT=8080

# === Юзербот: свежая initData БЕЗ ваших действий ===
# Запустите login_bot.bat ОДИН РАЗ: телефон, код из Telegram, пароль 2FA.
# Появится userbot.session — и бот сам будет открывать мини-апп, когда ключ
# устареет. Никаких HAR и файлов больше не нужно.
# ВАЖНО: публичная пара ниже часто ловит «403 RECAPTCHA_CHECK» (анти-спас
# Telegram). Свои бесплатные ключи: my.telegram.org -> API development tools
# (login_bot.bat сам предложит их ввести и сохранит сюда).
# Отложенные пуши через серверы Telegram: бот планирует «⏰ Готово: …» на момент
# финиша таймера (план живёт на серверах Telegram — придёт даже при выключенном
# боте, В ЧАТ С БОТОМ). Требует userbot.session; чужие отложенные сообщения
# в чате с ботом не трогаются (только помеченные «⏰ Готово: »).
USERBOT_SCHEDULE=true
USERBOT_API_ID=6
USERBOT_API_HASH=eb06d4abfb49dc3eeb1aeb98ae0f581e
USERBOT_SESSION_PATH=userbot.session

# === Публикация с телефона (github_push.sh, Termux) ===
# Персональный токен GitHub (PAT). Если вписан — push идёт без запроса
# логина/пароля. Не публикуйте этот файл: .env никогда не попадает в git.
GITHUB_TOKEN=
