# === Основное ===
# Токен от @BotFather (создать бота: /newbot)
BOT_TOKEN=
# Часовой пояс по умолчанию (IANA)
DEFAULT_TZ=Europe/Moscow
# Файл БД (можно не менять)
DB_PATH=data/fomo_timers.db

# Предупреждение «через минуту» до финиша (вы выбрали «Только T-0» — оставьте false)
WARN_ENABLED=false

# === Автотрекинг через API игры (Вариант 2) ===
# Заполняется ПОСЛЕ снятия трафика (README → «Автотрекинг, шаг 2»):
API_ENABLED=false
# Базовый адрес API игры, например https://api.fomofighters.example
API_BASE_URL=
# Строка заголовка авторизации целиком из Copy as cURL, например:
#   Authorization: Bearer eyJhbGciOiJIUzI1NiIs...
API_AUTH_HEADER=
# Интервал опроса в секундах (не ставьте меньше 30)
API_POLL_INTERVAL=45
# Ваш tg_id (узнать у @userinfobot) — кому ставить таймеры, найденные в API
API_OWNER_TG_ID=
