# ============================================================
#  Личные данные — в git НЕ попадают никогда.
#  Всё, что здесь перечислено, живёт только на вашем ПК.
# ============================================================

# --- Токены и доступы (главный секрет!) ---
.env
github_repo.txt

# --- Личная инструкция по GitHub (в публичный README не входит) ---
GITHUB.md

# --- Сессия юзербота = ваш вход в Telegram ---
userbot.session
*.session
*.session-journal

# --- Снимки трафика игры (внутри initData — временный ключ аккаунта) ---
fomo.txt
*.har
*.curl
har_report.txt
token_updates/

# --- Локальные данные: база таймеров, логи трассировки ---
data/

# --- Python: виртуальное окружение и кэш ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- Мусор ОС и установщиков ---
Thumbs.db
desktop.ini
.DS_Store
*.log
python-installer.exe

# --- Туннель cloudflared для мини-аппа (~20 МБ, качается сам) ---
cloudflared.exe
cloudflared

# --- Служебное (только локально): архив обновлений и батник публикации ---
# Архив качается из чата с ботом-разработчиком в папку проекта,
# github_push.bat сам его распакует и запушит — в git они не нужны.
fomo-timer-bot.zip
github_push.bat
github_push.bat.new
